# Copy to .env.local and fill in. Never commit the filled-in file —
# .env.local is gitignored for exactly this reason.

# ─── Circle (required) ────────────────────────────────────────────────────────
# Console → API Keys. Use a mainnet key; this app settles real funds.
CIRCLE_API_KEY=
# Console → Entity Secret → Create. Shown once, and the recovery file it issues
# is the only way back if you lose it. Rotating it invalidates the old one
# immediately, so update every deployment before the old secret stops working.
CIRCLE_ENTITY_SECRET=

# ─── Database (required) ──────────────────────────────────────────────────────
# Local dev: "file:./dev.db"   Production: a Postgres connection string.
DATABASE_URL="file:./dev.db"

# ─── Auth (required) ──────────────────────────────────────────────────────────
# The app's own origin. Must match the deployed URL or sign-in redirects break.
NEXTAUTH_URL=http://localhost:3000
# Any long random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# ─── Email (required for signup OTP and password reset) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
# "true" only for port 465; STARTTLS on 587 wants false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Falls back to SMTP_USER when unset.
SMTP_FROM=

# ─── Rate limiting (required in production) ───────────────────────────────────
# Upstash → Redis → REST API. Without these, payment endpoints are unthrottled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Scheduled jobs (required in production) ──────────────────────────────────
# Shared secret the cron routes check as `Authorization: Bearer <value>`.
# Set the same value in your host's cron configuration.
CRON_SECRET=

# ─── Tuning (optional — sensible defaults in lib/) ────────────────────────────
# Smallest balance worth consolidating onto the hub chain. Default 0.01.
SWEEP_MIN_AMOUNT=
# Floor for withdrawals leaving Arc, in USDC/EURC. Default 1.
# Withdrawals to Arc and all deposits have no minimum.
MIN_WITHDRAWAL=
